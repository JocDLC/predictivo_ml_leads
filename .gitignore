# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/

# IDE
.vscode/
.idea/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# ============================================================
# DATA — PII y archivos pesados
# ============================================================
# Raw data con datos personales (nombres, telefonos, correos) — NUNCA subir
data/raw/
# Processed CSVs (regenerables desde notebooks)
# Excepcion: los datasets del Reporte del Modelo SI se versionan para
# Streamlit Cloud (sin PII: encodings numericos y columnas de negocio).
data/processed/*.csv
!data/processed/leads_cleaned.csv
!data/processed/X_train_v2.csv
!data/processed/X_test_v2.csv
!data/processed/y_train_v2.csv
!data/processed/y_test_v2.csv
# Base de datos SQLite de historial (local)
data/memory/*.db

# Excel files from Salesforce (too large / PII)
*.xlsx
# Exception: test sample files anonimizados para demo
!data/test/*.xlsx

# ============================================================
# MODELOS — binarios regenerables
# ============================================================
# preprocessing_config.joblib SI se versiona: la app lo necesita en Streamlit Cloud
models/trained/

# ============================================================
# ESTRUCTURA OBSOLETA (V1)
# ============================================================
configs/
deployment/
src/api/
src/data/
src/features/
src/models/
# docs/ contiene analisis con datos de negocio (no van al repo),
# pero los workflows/profiles del harness si se versionan
docs/*
!docs/workflows/
!docs/profiles/

# ============================================================
# ARCHIVOS TEMPORALES Y SCRIPTS DE PRUEBA
# ============================================================
*.tmp
*.pdf
dataset_analysis.txt
prueba*.py
create_notebook.py
create_v2_notebooks.py
update_00_notebook.py
scripts/_check_doc.py

# Word temp lock files
~$*.docx

# ============================================================
# HERRAMIENTAS LOCALES
# ============================================================
# MLflow (legacy)
mlruns/
mlflow.db

# .agents/ queda versionado: el harness lo usa para reglas cross-IDE

# Graphify converted files con PII (leads crudos convertidos a markdown)
graphify-out/converted/Leads*

# OS files
Thumbs.db
.DS_Store

# Backups
*.bak

# Residuos locales
nul
streamlit*.log
# Modelos dentro de notebooks (binarios regenerables, duplican models/)
notebooks/models/
